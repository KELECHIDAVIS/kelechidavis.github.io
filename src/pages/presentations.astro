---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const talks = (await getCollection('talks')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Base title="Presentations">
  <h1>Presentations</h1>
  {talks.map((t) => (
    <article>
      <h2>{t.data.title}</h2>
      <p>{t.data.venue}, {t.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long' })}</p>
      <p>{t.data.summary}</p>
      {t.data.video && <a href={t.data.video}>Video</a>}
      {t.data.slides && <a href={t.data.slides}>Slides</a>}
    </article>
  ))}
</Base>
