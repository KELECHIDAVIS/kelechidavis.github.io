---
import '../styles/global.css';
const { title: t, frontmatter, wide } = Astro.props;
const cls = wide ? 'container wide' : 'container';
const title = t ?? frontmatter?.title ?? 'Your Name';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const nav = [
  ['/', 'Home'],
  ['/presentations', 'Presentations'],
  ['/projects', 'Projects'],
  ['/experience', 'Experience & CV'],
  ['/blog', 'Blog'],
  ['/fun', 'Fun'],
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-nav">
      <nav class={cls}>
        {nav.map(([href, label]) => (
          <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
        ))}
      </nav>
    </header>
    <main class={cls}>
      <slot />
    </main>
  </body>
</html>